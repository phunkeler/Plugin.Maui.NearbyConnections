      <!-- <DEVICE2_SERIAL>your-serial-2</DEVICE2_SERIAL> -->
      <!-- Appium server URL — defaults to localhost:4723 if not set -->
      <!-- <APPIUM_SERVER_URL>http://192.168.x.pi:4723</APPIUM_SERVER_URL> -->
      <!-- App package — defaults to com.phunkeler.nearbychat if not set -->
      <!-- <APP_PACKAGE>com.phunkeler.nearbychat</APP_PACKAGE> -->
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
