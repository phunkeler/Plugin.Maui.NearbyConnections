<BasePage
    x:Class="NearbyChat.Pages.DiscoveryPage"
    x:Name="this"
    x:TypeArguments="DiscoveryPageViewModel"
    Background="{AppThemeBinding Light={StaticResource LightBackgroundGradient}, Dark={StaticResource DarkBackgroundGradient}}"
    x:DataType="DiscoveryPageViewModel">

    <BasePage.Content>
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="{StaticResource SpacingXL}"
              Margin="{StaticResource SpacingXL}">
            <Button Style="{StaticResource BackButtonStyle}"
                    AutomationId="BackButton"
                    Command="{Binding BackCommand}"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"/>
            <!-- Test-only hook for UI automation. Opacity="0" (fully zero
                 alpha) is pruned from Android's accessibility tree by the
                 OS itself — independent of MAUI's own accessibility mapping
                 — so UIAutomator2 can never find it via any locator, no
                 matter what AutomationId is set to. A small nonzero
                 opacity keeps it out of the accessibility-pruning path
                 while remaining visually imperceptible. -->
            <Label AutomationId="DiscoveryStatus"
                   Text="{Binding IsDiscovering}"
                   Opacity="0.01" />
            <ConnectedDevicesChip
                Count="{Binding Connections.Count}"
                Command="{Binding NavigateToConnectionsCommand}"
                HorizontalOptions="End"
                VerticalOptions="Center"/>
            <FeatureControlCard
                VerticalOptions="Start"
                Grid.Row="1"
                ButtonAutomationId="ToggleDiscovery"
                FeatureIconBadgeStyle="{StaticResource FeatureIconBadgeDiscoverStyle}"
                Title="Discovery Mode"
                ActiveSubtitle="Scanning"
                InactiveSubtitle="Not scanning"
                ActiveButtonText="Stop Discovery"
                InactiveButtonText="Start Discovery"
                ActiveButtonColor="{StaticResource AccentDiscovery}"
                InactiveButtonColor="{AppThemeBinding Light={StaticResource LightSurfaceSecondary}, Dark={StaticResource DarkSurfaceSecondary}}"
                FeatureIsActive="{Binding IsDiscovering}"
                Command="{Binding ToggleDiscoveryCommand}"/>

            <CollectionView
                Margin="0,-8,0,0"
                Grid.Row="2"
                ItemsSource="{Binding DiscoveredDevices}"
                VerticalScrollBarVisibility="Never"
                HorizontalScrollBarVisibility="Never">
                <CollectionView.Header>
                    <Label
                        Margin="{StaticResource SpacingSM}"
                        IsVisible="{Binding DiscoveredDevices.Count, Converter={StaticResource intToBoolConverter}}"
                        Text="Nearby Devices"
                        Style="{StaticResource ListHeader}"/>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="DiscoveredDeviceViewModel">
                        <Border Style="{StaticResource FeatureNavigationCardBorderStyle}">
                            <Grid RowDefinitions="*, *, Auto"
                                  RowSpacing="{StaticResource SpacingSM}">
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource CardTitle}"
                                    Text="{Binding DisplayName}"/>
                                <Border
                                    Stroke="Transparent"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    HorizontalOptions="End"
                                    StrokeShape="RoundRectangle 10"
                                    Background="{StaticResource LightTextQuaternary}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsConnecting}"
                                                     Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource StatusInfo}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Image
                                        WidthRequest="10"
                                        HeightRequest="10">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="NearbyChatIcons"
                                                Glyph="{StaticResource icon-magnify}"
                                                Color="White"/>
                                        </Image.Source>
                                        <Image.Triggers>
                                            <DataTrigger TargetType="Image"
                                                         Binding="{Binding IsConnecting}"
                                                         Value="True">
                                                <Setter Property="Source">
                                                    <Setter.Value>
                                                        <FontImageSource
                                                            FontFamily="NearbyChatIcons"
                                                            Glyph="{StaticResource icon-link}"
                                                            Color="White"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Border>
                                <Label
                                    Grid.Row="1"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource CardSubtitle}"
                                    Text="{Binding ReceivedAt, Converter={StaticResource relativeTimeConverter}, Mode=OneWay}"/>
                                <Button
                                    Grid.Row="2"
                                    HeightRequest="44"
                                    Text="Connect"
                                    AutomationId="{Binding Id, StringFormat='Connect_{0}'}"
                                    Command="{Binding ConnectCommand}"
                                    BackgroundColor="{StaticResource AccentConnections}"
                                    TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    FontSize="{StaticResource FontSizeSM}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="{StaticResource SpacingLG}">
                        <Image
                            x:Name="SonarIcon"
                            WidthRequest="56"
                            HeightRequest="56">
                            <Image.Source>
                                <FontImageSource x:Name="SonarIconSource"
                                                 FontFamily="NearbyChatIcons"
                                                 Glyph="{StaticResource icon-sonar}"
                                                 Color="{AppThemeBinding Light={StaticResource LightTextQuaternary}, Dark={StaticResource DarkTextQuaternary}}"/>
                            </Image.Source>
                        </Image>
                        <Label
                            TextColor="{AppThemeBinding Light={StaticResource LightTextQuaternary}, Dark={StaticResource DarkTextQuaternary}}"
                            HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsDiscovering}"
                                             Value="False">
                                    <Setter Property="Text"
                                            Value="Start discovering nearby devices"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsDiscovering}"
                                             Value="True">
                                    <Setter Property="Text"
                                            Value="Scanning for nearby devices..."/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </BasePage.Content>
</BasePage>