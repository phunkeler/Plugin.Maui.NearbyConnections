<Project>

  <!-- Versioning -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="6.0.0" />
  </ItemGroup>

  <!-- Analyzers -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- Library -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Maui.Core" Version="10.0.51" />
    <PackageVersion Include="Xamarin.GooglePlayServices.Nearby" Version="119.3.0.7" />
  </ItemGroup>

  <!-- Sample -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Maui" Version="14.0.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.9.26258.5" />
    <PackageVersion Include="Plugin.Maui.BottomSheet" Version="10.0.6" />
  </ItemGroup>

  <!-- Unit Tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.3.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <!-- Device Tests -->
  <ItemGroup>
    <PackageVersion Include="DeviceRunners.Testing.Targets" Version="0.1.0-preview.12" />
    <PackageVersion Include="DeviceRunners.VisualRunners.Maui" Version="0.1.0-preview.12" />
    <PackageVersion Include="DeviceRunners.VisualRunners.Xunit3" Version="0.1.0-preview.12" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <!-- Pinned to what xunit.v3 3.2.2 resolves, so this suite and the UI suite (which gets the
         analyzers transitively via the xunit.v3 metapackage) agree on what is a warning. -->
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
  </ItemGroup>

  <!-- UI Tests -->
  <ItemGroup>
    <PackageVersion Include="Appium.WebDriver" Version="4.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>